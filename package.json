{
  "name": "music-together",
  "version": "1.0.0",
  "private": true,
  "description": "Online music listening together platform",
  "scripts": {
    "predev": "kill-port 3001 --silent || true",
    "dev": "concurrently --kill-others --names server,client --prefix-colors blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev -w packages/client",
    "dev:server": "npm run dev -w packages/server",
    "build": "npm run build --workspaces",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"packages/shared/src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "kill-port": "^2.0.1",
    "prettier": "^3.8.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
